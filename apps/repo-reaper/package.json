{
  "name": "@necrokit/repo-reaper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "node --experimental-strip-types --no-warnings --import ./src/register.mjs src/cli.ts src/fixtures/neglected.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "node --experimental-strip-types --no-warnings --import ./src/register.mjs src/cli.ts"
  },
  "dependencies": {
    "@necrokit/core": "workspace:*",
    "zod": "3.24.4"
  }
}
