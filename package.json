{
  "name": "necrokit",
  "private": true,
  "version": "0.1.0",
  "description": "A reusable evidence-first maintenance-analysis skeleton for two applications.",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && pnpm build:site",
    "build:site": "node scripts/build.mjs",
    "dev": "pnpm build:site && node scripts/serve.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p site --noEmit",
    "scan:package": "pnpm --filter @necrokit/package-graveyard scan",
    "scan:repo": "pnpm --filter @necrokit/repo-reaper scan"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "esbuild": "0.25.12",
    "fast-check": "4.1.1",
    "typescript": "5.8.3",
    "vitest": "3.1.3",
    "@necrokit/core": "workspace:*",
    "zod": "3.24.4"
  }
}
